# ===========================================================================
# AuraFlow-AI — Environment Configuration
# ===========================================================================
# Copy this file to .env and customize for your setup.
# All variables have sensible defaults and are optional.
# ===========================================================================

# ── GPU & Acceleration ────────────────────────────────────────────────────
# Device selection: auto | cuda | cpu
AURA_DEVICE=auto

# Enable FP16 mixed precision (recommended for all AMD GPUs)
AURA_FP16=true

# Enable torch.compile() JIT compilation (Set to false by default for maximum AMD hardware compatibility)
# Set to true only if you have verified your specific GPU architecture supports inductor
AURA_TORCH_COMPILE=false

# Attention backend: sdpa | xformers | none
AURA_ATTENTION_BACKEND=sdpa

# ── AMD ROCm Configuration ───────────────────────────────────────────────
# Override GFX version for GPU compatibility
# Common values:
#   RX 7900 XTX/XT → 11.0.0    RX 7800 XT → 11.0.1
#   RX 7600       → 11.0.2    RX 6900/6800 → 10.3.0
#   RX 6700 XT    → 10.3.1    RX 6600 XT   → 10.3.2
#   MI300X        → 9.4.2     MI250X       → 9.0.10
HSA_OVERRIDE_GFX_VERSION=11.0.0

# ROCm architecture target
PYTORCH_ROCM_ARCH=gfx1100

# Visible GPU devices (0-indexed)
HIP_VISIBLE_DEVICES=0

# PyTorch HIP memory allocator config
PYTORCH_HIP_ALLOC_CONF=max_split_size_mb:512

# torch.compile backend
TORCH_COMPILE_BACKEND=inductor

# ── Model Paths ───────────────────────────────────────────────────────────
# HuggingFace model cache directory
HF_HOME=./models/hf_cache

# Override specific model paths (optional)
# SDXL_MODEL_PATH=./models/sdxl
# INPAINTING_MODEL_PATH=./models/inpainting
# ANIMATEDIFF_MODEL_PATH=./models/animatediff

# Piper TTS model path
# PIPER_MODEL=en_US-lessac-medium

# ── Server ────────────────────────────────────────────────────────────────
AURA_HOST=0.0.0.0
AURA_PORT=8000
